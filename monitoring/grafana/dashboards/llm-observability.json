        {"expr": "marketing_collateral_db_p95_latency_ms / 1000", "legendFormat": "p95", "refId": "B"}
      ],
      "title": "Average and P95 LLM latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
